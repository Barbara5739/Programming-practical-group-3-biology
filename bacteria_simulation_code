# imports the things that are needed to run the code
import math
import os
import numpy as np
import matplotlib.pyplot as plt
from scipy import stats

# defines the function that calculates momentum
def momentum(px, py, pz):
    return math.sqrt(px**2 + py**2 + pz**2)

# defines a function that processes the file
def process_file(filepath, bins):
    # the target ID's we are looking for
    target_ids = [2212, -2212]
    # creates lists in which to store the data for each ID
    momenta = {2212: [], -2212: []}

#opens the file
    with open(filepath, 'r') as file:
        for line in file:
            # for every line in the file it removes the invisible \n's if there are any and splits the line into parts at every space
            parts = line.strip().split()
            # 4 parts = we are looking at data
            if len(parts) == 4:
                # tells the computer which part of the data is px, py and pz using map
                px, py, pz, lineid = map(float, parts)
                # turns the line ID into an integer
                lineid = int(lineid)
                # if the ID is among the ID's we are looking for, it calculates the total momentum and adds the data to the correct list
                if lineid in target_ids:
                    momenta[lineid].append(momentum(px, py, pz))

    # creates histograms for both ID's
    hist_id1, _ = np.histogram(momenta[2212], bins=bins)
    hist_minusid, _ = np.histogram(momenta[-2212], bins=bins)

    # gets the name of the file from the filepath
    filename = os.path.basename(filepath)

    # creates and saves the graphs for each and every file, for both ID's. They can be printed, however that results in the code running only until the first file is processed.
    plt.figure(figsize=(8, 4))
    plt.bar(bins[:-1], hist_id1, width=binwidths, align='edge', edgecolor='black', color='blue', alpha=0.5)
    plt.title(f"ID Momentum - {filename}")
    plt.xlabel("Momentum Range")
    plt.ylabel("Frequency (Counts)")
    plt.savefig(f"ID_ID1_{filename}.png") 
    plt.close()

    plt.figure(figsize=(8, 4))
    plt.bar(bins[:-1], hist_minusid, width=binwidths, align='edge', edgecolor='black', color='red', alpha=0.5)
    plt.title(f" minus ID Momentum - {filename}")
    plt.xlabel("Momentum Range")
    plt.ylabel("Frequency (Counts)")
    plt.savefig(f"minusID_{filename}.png")
    plt.close()

    # returns the two histograms
    return hist_id1, hist_minusid


# it generates larger bins each time (it starts at 0)
binedges = [0]
# the first bin width is 10
step = 10
# creates a maximum treshold for momentum
while binedges[-1] < 150: 
    # the adds the last step to bin_edges
    binedges.append(binedges[-1] + step)
    # increases the step
    step += 5
    # turns the result into a numpy array
binedges = np.array(binedges)

# calculates the centre of every bin
bincenters = (binedges[:-1] + binedges[1:]) / 2
# np.diff calculates the bin widths: it subtracts each bin edge from the one after it
binwidths = np.diff(binedges)
# Y error bars are half the bin widths both in the left and the right direction
x_err = binwidths / 2  

# the file paths
filepaths = [
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set1.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set3.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set4.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set5.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set6.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set7.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set8.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set9.txt",
        "/Users/barbatcs/Documents/python_practical_2026/MAT2007/output-Set10.txt"
        
    ]
# creates lists for the data how many data points are in each bin
allhistograms1 = []
allhistograms2 = []

# repeats this for every file
for path in filepaths:
    # looks for the data in the file and adds it to the list
    try:
        h_211, h_m211 = process_file(path, binedges)
        allhistograms1.append(h_211)
        allhistograms2.append(h_m211)
    # it prints this if it cannot find the file
    except FileNotFoundError:
        print(f"Skipping {path} - File not found.")

if len(allhistograms1) > 0:
    # it turns the lists into numpy arrays for the calculations
    allhistograms1 = np.array(allhistograms1)
    allhistograms2 = np.array(allhistograms2)

    # calculates the difference between the two histograms for every file
    differences = allhistograms1 - allhistograms2
    # calculates the average difference and the uncertainty: the y error bars (standard deviation)
    mean_diff = np.mean(differences, axis=0)
    y_err = np.std(differences, axis=0, ddof=1)

    # prints what it's going to calculate
    print("\nStatistical Significance calculation using an unpaired t-test: ")
    
    for i in range(len(bincenters)):
        # if both arrays look the same, p-value is 1.0, meaning no difference
        if np.array_equal(allhistograms1[:, i], allhistograms2[:, i]):
            p_value = 1.0
        else:
            # it uses an unpaired t-test
            stat, p_value = stats.ttest_ind(allhistograms1[:, i], allhistograms2[:, i])

        # it prints whether the difference is significant or not significant for each data point
        significance = "Significant" if p_value < 0.05 else "Not Significant"
        print(f"Range [{binedges[i]:>3} - {binedges[i+1]:>3}]: p-value = {p_value:.4f} ({significance})")

    # tells the computer how big the figure should be
    plt.figure(figsize=(10, 6))
    
    # fmt='o' makes a scatter plot point, capsize adds the caps to the error bars
    plt.errorbar(bincenters, mean_diff, xerr=x_err, yerr=y_err, 
                 fmt='o', color='purple', ecolor='black', capsize=4, elinewidth=1, markersize=6)
    # adds title, x and y labels
    plt.title("Average Momentum Difference between the Wild Type and the Mutant Type with Uncertainties")
    plt.xlabel("Momentum")
    plt.ylabel("Difference in Average Frequency")
    # adds a horizontal line at y=0
    plt.axhline(0, color='green', linestyle='--', linewidth=1) 
    # shows the plot
    plt.show()
# if it cannot find data it prints this
else:
    print("No data was processed.")

